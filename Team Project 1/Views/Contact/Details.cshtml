@model Contact
@{
    ViewData["Title"] = "Contact Details";
}

<h2>Contact Details</h2>

<div>
    <ul>
        <li class="list-group-item">
            <span>Name:</span> @Model.FirstName @Model.LastName
        </li>
        <li class="list-group-item">
            <span>Phone:</span> @Model.Phone
        </li>
        <li class="list-group-item">
            <span>Email:</span> @Model.Email
        </li>
        <li class="list-group-item">
            <span>Category:</span> @Model.Category.Name
        </li>
        <li class="list-group-item">
            <span>Organization:</span> @Model.Organization
        </li>
        <li class="list-group-item">
            <span>Date added:</span> @Model.DateAdded.ToString("M/d/yyyy")
        </li>
        
        <li class="list-group-item">
            <a asp-action="Edit" asp-route-id="@Model.ContactId" class="btn btn-dark">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.ContactId" asp-route-slug="@Model.Slug" class="btn btn-dark">Delete</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Home</a>
        </li>
    </ul>
</div>
