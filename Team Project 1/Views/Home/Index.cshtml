@model List<Team_Project_1.Models.Contact>
@{
    ViewData["Title"] = "Contact Manager";
}

<div>
    <a asp-controller="Contact" asp-action="Add">Add Contact</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Category</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var contact in Model)
        {
            <tr>
                <td>
                    <a asp-controller="Contact"
                       asp-action="Details"
                       asp-route-id="@contact.ContactId"
                       asp-route-slug="@contact.Slug">
                        @contact.FirstName
                    </a>
                </td>

                <td>
                    <a asp-controller="Contact"
                       asp-action="Details"
                       asp-route-id="@contact.ContactId"
                       asp-route-slug="@contact.Slug">
                        @contact.LastName
                    </a>
                </td>

                <td>@contact.Phone</td>
                <td>@contact.Email</td>
                <td>@contact.Category.Name</td>
            </tr>
        }
    </tbody>
</table>
